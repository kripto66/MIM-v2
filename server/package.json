{
  "name": "mim-server",
  "version": "2.0.0",
  "description": "Backend Okarne Global Management - Node.js + Supabase",
  "main": "server.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "cron:loyers": "node scripts/checkLoyers.js",
    "test": "npm run test:syntax && npm run test:e2e",
    "test:syntax": "node scripts/quality.mjs syntax",
    "test:e2e": "node scripts/tests/run.js",
    "lint": "node scripts/quality.mjs lint",
    "typecheck": "node scripts/quality.mjs typecheck",
    "schema:dump": "node scripts/dump-schema.mjs",
    "schema:seed": "node scripts/dump-schema.mjs --seed",
    "db:backup": "node scripts/backup.mjs",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10"
  }
}
