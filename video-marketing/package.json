    "render": "npm run render:landscape && npm run render:portrait"
  },
  "dependencies": {
    "@remotion/cli": "4.0.527",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.527"
  }
}
