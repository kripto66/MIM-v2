{
  "name": "mim-video-marketing",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preview": "remotion studio src/index.js",
    "render:landscape": "remotion render src/index.js MimVideoLandscape out/mim-marketing-16x9.mp4",
